<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · FormaOps</title>
  <link rel="stylesheet" href="/static/style.css">
  <% if (typeof autoRefresh !== 'undefined' && autoRefresh) { %><meta http-equiv="refresh" content="<%= autoRefresh %>;url=<%= typeof autoRefreshUrl !== 'undefined' ? autoRefreshUrl : '' %>"><% } %>
</head>
<body>
<% var hasNav = typeof nav !== 'undefined'; var sec = typeof section !== 'undefined' ? section : ''; %>
<header class="bar">
  <a class="logo" href="/">FormaOps</a>
  <nav>
    <a href="/" class="<%= sec === 'arrivi' ? 'here' : '' %>">Arrivi<% if (hasNav && nav.inbox.rispondere) { %><span class="count <%= nav.inbox.urgenti ? 'hot' : '' %>" title="<%= nav.inbox.rispondere %> da rispondere, <%= nav.inbox.urgenti %> urgenti"><%= nav.inbox.rispondere %></span><% } %></a>
    <a href="/clienti" class="<%= sec === 'clienti' ? 'here' : '' %>">Clienti</a>
    <a href="/da-collegare" class="<%= sec === 'collegare' ? 'here' : '' %>">Da collegare<% if (hasNav && nav.unlinked) { %><span class="count"><%= nav.unlinked %></span><% } %></a>
    <a href="/verifica" class="<%= sec === 'verifica' ? 'here' : '' %>">Da verificare<% if (hasNav && nav.reviewOpen) { %><span class="count"><%= nav.reviewOpen %></span><% } %></a>
    <a href="/impostazioni" class="<%= sec === 'impostazioni' ? 'here' : '' %>">Impostazioni</a>
    <a class="btn" href="/customers/new">Nuovo cliente</a>
  </nav>
</header>
<main>
