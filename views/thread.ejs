<% var name = t.customer_id ? t.customer_name : (t.counterpart_name || displayAddress(t.contact_type, t.counterpart_address)); %>
<%- include('_top', { title: name, section: 'regia' }) %>
<a class="back" href="<%= back %>">Torna alla Regia</a>
<% if (flash) { %><p class="ok"><%= flash %></p><% } %>

<header class="page-head">
  <div>
    <h1><%= name %></h1>
    <div class="thread-meta">
      <span class="st st-<%= t.status %>"><%= THREAD_STATUS_LABEL[t.status] %><% if (t.status === 'rimandata') { %> fino al <%= day(t.snooze_until) %><% } %></span>
      <% if (t.status === 'da_rispondere') { %><span class="<%= t.urgent ? 'error-text' : '' %>">aspetta <%= waitedLong(t.waited_hours) %></span><% } %>
      <span><%= SOURCE_LABEL[t.source] %>, <%= displayAddress(t.contact_type, t.counterpart_address) %><% if (t.account && t.source !== 'gmail') { %>, su <%= t.account %><% } %></span>
    </div>
  </div>
  <div class="actions">
    <% if (t.status === 'da_rispondere') { %>
      <details class="more">
        <summary>Altro</summary>
        <div class="menu">
          <form method="post" action="/conversazioni/stato">
            <input type="hidden" name="k" value="<%= t.thread_key %>"><input type="hidden" name="da" value="<%= back %>">
            <button class="quiet" name="azione" value="attesa">Ho già risposto altrove</button>
            <button class="quiet" name="azione" value="chiudi">Chiudi senza rispondere</button>
          </form>
          <hr>
          <div class="lbl">Rimanda</div>
          <form method="post" action="/conversazioni/stato">
            <input type="hidden" name="k" value="<%= t.thread_key %>"><input type="hidden" name="da" value="<%= back %>"><input type="hidden" name="azione" value="rimanda">
            <button class="quiet" name="giorni" value="1">A domani</button>
            <button class="quiet" name="giorni" value="3">Tra 3 giorni</button>
            <button class="quiet" name="giorni" value="7">Tra una settimana</button>
          </form>
        </div>
      </details>
    <% } else { %>
      <form method="post" action="/conversazioni/stato" class="inline-form">
        <input type="hidden" name="k" value="<%= t.thread_key %>"><input type="hidden" name="da" value="<%= here %>">
        <% if (t.status !== 'chiusa') { %><button name="azione" value="chiudi" class="secondary">Chiudi</button><% } %>
        <% if (t.manual_status && t.manual_status === t.status) { %><button name="azione" value="riapri" class="secondary">Riapri</button><% } %>
      </form>
    <% } %>
    <% if (t.link) { %><a class="btn" href="<%= t.link %>" target="_blank" rel="noopener">Rispondi in <%= ({ gmail: 'Gmail', messenger: 'Meta', instagram: 'Meta', facebook_comment: 'Facebook', instagram_comment: 'Instagram' })[t.source] || 'nel canale' %></a><% } %>
  </div>
</header>

<div class="thread-layout">
  <div>
    <div class="timeline">
      <% t.messages.forEach(function (m) { %>
        <div class="bubble <%= m.direction %>">
          <div class="meta"><%= m.direction === 'out' ? 'Tu' : (m.counterpart_name || displayAddress(m.contact_type, m.counterpart_address)) %>, <%= when(m.sent_at) %></div>
          <% if (m.source === 'gmail' && m.subject) { %><div class="subj"><%= m.subject %></div><% } %>
          <div class="body"><%= m.snippet || '(senza testo)' %></div>
        </div>
      <% }) %>
    </div>
    <p class="note">Qui vedi l'anteprima dei messaggi. Il testo completo e la risposta sono nel canale originale.
      <% if (t.status !== 'da_rispondere') { %>Se il cliente riscrive, la conversazione torna da sola tra quelle per te.<% } %></p>

    <section class="draft" id="bozza">
      <div class="draft-head">
        <h2>Bozza dell'AI</h2>
        <% if (draft) { %><span class="muted small">scritta alle <%= clock(draft.created_at) %><%= draft.instruction ? ', con la tua indicazione: "' + draft.instruction + '"' : '' %></span><% } %>
      </div>
      <% if (aiError) { %><p class="error small"><%= aiError %></p><% } %>
      <% if (t.relationship === 'personale') { %>
        <p class="small muted" style="margin: 0">Contatto personale: l'AI non scrive bozze per questi contatti.</p>
      <% } else if (!aiReady) { %>
        <p class="small muted" style="margin: 0">L'assistente AI non è ancora collegato. <a href="/impostazioni#ai">Collegalo in Impostazioni</a>.</p>
      <% } else { %>
        <% if (draft) { %>
          <% if (draftStale) { %><p class="warn small">Il cliente ha scritto dopo questa bozza: rigenerala per tenerne conto.</p><% } %>
          <label class="sr-only" for="draft-text">Testo della bozza</label>
          <textarea id="draft-text" rows="<%= Math.min(18, Math.max(6, draft.draft.split('\n').length + Math.ceil(draft.draft.length / 90))) %>"><%= draft.draft %></textarea>
          <div class="actions">
            <% if (t.link) { %><button type="button" data-url="<%= t.link %>" onclick="copyDraft(this.dataset.url)">Copia e apri in <%= ({ gmail: 'Gmail', messenger: 'Meta', instagram: 'Meta', facebook_comment: 'Facebook', instagram_comment: 'Instagram' })[t.source] || 'nel canale' %></button><% } %>
            <button type="button" class="secondary" onclick="copyDraft()">Copia</button>
            <span class="small muted" id="copied" role="status"></span>
          </div>
          <p class="note" style="margin-top: 8px">Controlla sempre prezzi, date e nomi prima di inviare. Le parti tra [DA COMPLETARE] le devi scrivere tu.</p>
        <% } %>
        <form method="post" action="/conversazioni/bozza" class="regen" onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent='Scrivo…'">
          <input type="hidden" name="k" value="<%= t.thread_key %>"><input type="hidden" name="da" value="<%= back %>">
          <input name="indicazione" maxlength="500" placeholder="<%= draft ? 'Indicazione per rifarla (es. più breve, proponi il ritiro in laboratorio)' : 'Indicazione facoltativa per l\'AI' %>" aria-label="Indicazione per l'AI">
          <button type="submit" class="<%= draft ? 'secondary' : '' %>"><%= draft ? 'Rigenera' : 'Prepara bozza' %></button>
        </form>
      <% } %>
    </section>
  </div>

  <aside>
    <% if (summary) { %>
      <section class="card">
        <h2><a href="/customers/<%= t.customer_id %>" style="color: inherit"><%= t.customer_name %></a></h2>
        <form method="post" action="/customers/<%= t.customer_id %>/relazione" class="relform" style="margin-bottom: 14px">
          <input type="hidden" name="da" value="<%= here %>">
          <select name="relazione" onchange="this.form.submit()" aria-label="Relazione">
            <option value="">Automatica: <%= RELATIONSHIP_LABEL[summary.relationship.auto] %></option>
            <% RELATIONSHIPS.forEach(function (r) { %><option value="<%= r %>" <%= summary.relationship.manual === r ? 'selected' : '' %>><%= RELATIONSHIP_LABEL[r] %></option><% }) %>
          </select>
          <noscript><button class="secondary">Salva</button></noscript>
        </form>
        <dl class="facts">
          <dt>Ordini</dt><dd><%= summary.orders %><% if (summary.orders) { %> (<%= money(summary.spent_minor, summary.currency || 'EUR') %>)<% } %></dd>
          <% summary.open_orders.forEach(function (o) { %>
            <dt>In corso</dt><dd><%= o.order_number %>, <%= (STATUS_LABEL[o.status] || o.status).toLowerCase() %></dd>
          <% }) %>
          <dt>Ultimo ordine</dt><dd><%= day(summary.last_order) %></dd>
          <dt>Primo contatto</dt><dd><%= day(summary.first_contact) %></dd>
          <dt>Canali</dt><dd><%= summary.sources.map(function (s) { return SOURCE_LABEL[s] || s; }).join(', ') || '—' %></dd>
        </dl>
      </section>
    <% } else { %>
      <section class="card">
        <h2>Non ancora collegato</h2>
        <p class="small" style="margin-top: 0">FormaOps non sa a quale cliente appartiene questo contatto. Collegalo una volta e dal messaggio successivo verrà riconosciuto da solo.</p>
        <a class="btn" href="/da-collegare#<%= encodeURIComponent(t.contact_type + ':' + t.counterpart_address) %>">Collega a un cliente</a>
      </section>
    <% } %>
  </aside>
</div>
<script>
function copyDraft(url) {
  var ta = document.getElementById('draft-text');
  if (!ta) return;
  var done = function () { var c = document.getElementById('copied'); if (c) c.textContent = 'Copiata'; if (url) window.open(url, '_blank', 'noopener'); };
  if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(ta.value).then(done, function () { ta.select(); document.execCommand('copy'); done(); });
  else { ta.select(); document.execCommand('copy'); done(); }
}
</script>
<%- include('_bottom') %>
