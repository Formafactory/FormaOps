<%- include('_top', { title: 'Clienti' }) %>
<% if (flash) { %><p class="<%= flash.startsWith('Errore') ? 'error' : 'ok' %>"><%= flash %></p><% } %>

<section class="syncbox">
  <div>
    <strong>Ordini Vir3D</strong>
    <% if (!sync.configured) { %>
      <span class="muted">— non collegato.</span> <a href="/impostazioni">Collega vir3d.it</a>
    <% } else if (sync.state.last_ok_at) { %>
      <span class="muted">— ultimo aggiornamento <%= when(sync.state.last_ok_at) %></span>
    <% } else { %>
      <span class="muted">— mai sincronizzati</span>
    <% } %>
    <% if (sync.state.last_error) { %><div class="error small">Ultimo errore: <%= sync.state.last_error %></div><% } %>
  </div>
  <div class="actions">
    <% if (sync.reviewOpen) { %><a href="/verifica"><%= sync.reviewOpen %> da verificare</a><% } %>
    <% if (sync.configured) { %>
      <form method="post" action="/sync/vir3d" class="inline-form"
            onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent='Aggiorno…'">
        <button type="submit">Aggiorna ordini</button>
      </form>
    <% } %>
  </div>
</section>

<h1>Clienti <span class="muted">(<%= total %>)</span></h1>

<form class="search" method="get" action="/">
  <input type="search" name="q" value="<%= q %>" placeholder="Nome, email, telefono, profilo, numero ordine" autofocus>
  <select name="brand">
    <option value="">Tutti i brand</option>
    <% BRANDS.forEach(function (b) { %>
      <option value="<%= b %>" <%= brand === b ? 'selected' : '' %>><%= BRAND_LABEL[b] %></option>
    <% }) %>
  </select>
  <button type="submit">Cerca</button>
  <% if (q || brand) { %><a href="/">Azzera</a><% } %>
</form>

<% if (customers.length === 0) { %>
  <p class="empty"><%= q || brand ? 'Nessun cliente trovato.' : 'Ancora nessun cliente.' %>
    <a href="/customers/new">Crea un cliente</a></p>
<% } else { %>
<table class="list">
  <thead><tr><th>Nome</th><th>Brand</th><th>Contatti</th><th>Ordini</th><th>Aggiornato</th></tr></thead>
  <tbody>
  <% customers.forEach(function (c) { %>
    <tr>
      <td><a href="/customers/<%= c.id %>"><strong><%= c.name %></strong></a></td>
      <td><span class="tag tag-<%= c.brand %>"><%= BRAND_LABEL[c.brand] %></span></td>
      <td class="contacts"><% c.contacts.forEach(function (k) { %><span title="<%= TYPE_LABEL[k.type] %>"><%= k.value_normalized %></span><% }) %></td>
      <td><%= c.order_count || '' %><% if (c.last_order_at) { %> <span class="muted small">ultimo <%= when(c.last_order_at).split(',')[0] %></span><% } %></td>
      <td class="muted"><%= when(c.updated_at).split(',')[0] %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% } %>
<%- include('_bottom') %>
