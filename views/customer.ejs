<%- include('_top', { title: customer.name, section: 'clienti' }) %>
<a class="back" href="/clienti">Tutti i clienti</a>
<header class="page-head">
  <div>
    <h1><%= customer.name %></h1>
    <div class="thread-meta">
      <span class="tag tag-<%= customer.brand %>"><%= BRAND_LABEL[customer.brand] %></span>
      <span>Cliente #<%= customer.id %>, nell'anagrafica dal <%= day(customer.created_at) %></span>
    </div>
  </div>
  <form method="post" action="/customers/<%= customer.id %>/relazione" class="relform">
    <label for="rel" class="small muted">Relazione</label>
    <select id="rel" name="relazione" onchange="this.form.submit()">
      <option value="">Automatica: <%= RELATIONSHIP_LABEL[summary.relationship.auto] %></option>
      <% RELATIONSHIPS.forEach(function (r) { %><option value="<%= r %>" <%= summary.relationship.manual === r ? 'selected' : '' %>><%= RELATIONSHIP_LABEL[r] %></option><% }) %>
    </select>
    <noscript><button class="secondary">Salva</button></noscript>
  </form>
</header>

<div class="summary">
  <div><div class="k">Ordini</div><div class="v"><%= summary.orders %></div></div>
  <div><div class="k">Speso in totale</div><div class="v"><%= money(summary.spent_minor, summary.currency || 'EUR') %></div></div>
  <div><div class="k">Ordini in corso</div><div class="v <%= summary.open_orders.length ? 'bronze' : '' %>"><%= summary.open_orders.length ? summary.open_orders.map(function (o) { return o.order_number; }).join(', ') : 'nessuno' %></div></div>
  <div><div class="k">Ultimo contatto</div><div class="v"><%= day(summary.last_contact) %></div></div>
</div>

<% if (error) { %><p class="error"><%= error %></p><% } %>
<% if (saved) { %><p class="ok">Salvato.</p><% } %>

<div class="grid">
  <section class="card">
    <h2>Contatti</h2>
    <% if (customer.contacts.length === 0) { %><p class="muted">Nessun contatto.</p><% } %>
    <ul class="contact-list">
      <% customer.contacts.forEach(function (k) { %>
        <li>
          <span class="type"><%= TYPE_LABEL[k.type] %></span>
          <span class="value"><%= k.type === 'facebook' && k.value_normalized.startsWith('fb:') ? (k.value_raw.startsWith('fb:') ? 'profilo collegato' : k.value_raw) : k.value_normalized %></span>
          <% if (k.value_raw !== k.value_normalized && !(k.type === 'facebook' && k.value_normalized.startsWith('fb:'))) { %><span class="muted">(<%= k.value_raw %>)</span><% } %>
          <form method="post" action="/customers/<%= customer.id %>/contacts/<%= k.id %>/delete" class="inline"
                onsubmit="return confirm('Rimuovere questo contatto?')">
            <button class="link" type="submit">rimuovi</button>
          </form>
        </li>
      <% }) %>
    </ul>
    <form class="add-contact" method="post" action="/customers/<%= customer.id %>/contacts">
      <select name="type">
        <% CONTACT_TYPES.forEach(function (t) { %>
          <option value="<%= t %>" <%= contactForm.type === t ? 'selected' : '' %>><%= TYPE_LABEL[t] %></option>
        <% }) %>
      </select>
      <input name="value" value="<%= contactForm.value || '' %>" placeholder="valore" required>
      <button type="submit">Aggiungi</button>
    </form>
  </section>

  <section class="card">
    <h2>Dati e note</h2>
    <form class="form" method="post" action="/customers/<%= customer.id %>">
      <label>Nome <input name="name" value="<%= customer.name %>" required></label>
      <label>Brand
        <select name="brand">
          <% BRANDS.forEach(function (b) { %>
            <option value="<%= b %>" <%= customer.brand === b ? 'selected' : '' %>><%= BRAND_LABEL[b] %></option>
          <% }) %>
        </select>
      </label>
      <label>Note <textarea name="notes" rows="8"><%= customer.notes %></textarea></label>
      <div class="actions"><button type="submit">Salva</button></div>
    </form>
  </section>
</div>

<section class="card">
  <h2>Messaggi e commenti <span class="muted">(<%= threads.length %> conversazioni)</span></h2>
  <% if (threads.length === 0) { %><p class="muted">Nessun messaggio.</p><% } %>
  <% threads.forEach(function (t) { var link = '/conversazione?k=' + encodeURIComponent(t.thread_key) + '&da=' + encodeURIComponent('/customers/' + customer.id); %>
    <div class="order">
      <div class="thread-line">
        <span class="st st-<%= t.status %>"><%= THREAD_STATUS_LABEL[t.status] %></span>
        <span class="chan chan-<%= t.source %>"><%= SOURCE_LABEL[t.source] || t.source %></span>
        <a class="subj" href="<%= link %>"><%= t.subject || '(senza oggetto)' %></a><% if (t.n > 1) { %> <span class="muted small">(<%= t.n %>)</span><% } %>
        <span class="muted small nowrap" style="margin-left:auto"><%= clock(t.last_at) %></span>
      </div>
      <div class="muted small"><%= t.direction === 'out' ? 'Tu: ' : '' %><%= t.snippet %></div>
    </div>
  <% }) %>
</section>

<section class="card">
  <h2>Ordini Vir3D <span class="muted">(<%= orders.length %>)</span></h2>
  <% reviews.forEach(function (r) { %><p class="error small">Da verificare: <%= r.detail %> (ordine <%= r.ref_id %>)</p><% }) %>
  <% if (orders.length === 0) { %><p class="muted">Nessun ordine.</p><% } %>
  <% orders.forEach(function (o) { %>
    <details class="order">
      <summary>
        <strong><%= o.order_number %></strong>
        <span class="muted"><%= when(o.created_at) %></span>
        <span class="tag status-<%= o.status %>"><%= STATUS_LABEL[o.status] || o.status %></span>
        <span class="amount"><%= money(o.total_minor, o.currency) %></span>
        <span class="muted small"><%= o.items.map(function (i) { return i.quantity + '× ' + i.product_name; }).join(', ') %></span>
      </summary>
      <div class="order-body">
        <table class="mini">
          <% o.items.forEach(function (i) { %>
            <tr><td><%= i.quantity %>×</td><td><%= i.product_name %></td>
              <td class="muted"><%= i.production_status || '' %></td><td class="amount"><%= money(i.total_price_minor, o.currency) %></td></tr>
          <% }) %>
          <tr><td></td><td class="muted">Spedizione</td><td></td><td class="amount"><%= money(o.shipping_minor, o.currency) %></td></tr>
          <% if (o.discount_minor) { %><tr><td></td><td class="muted">Sconto</td><td></td><td class="amount">−<%= money(o.discount_minor, o.currency) %></td></tr><% } %>
        </table>
        <p class="small">
          Pagamento: <%= o.payment_method || '—' %> (<%= o.payment_status || '—' %>)
          · Tracking: <%= o.tracking_number || '—' %>
          <% if (o.delivered_at) { %>· Consegnato <%= when(o.delivered_at) %><% } %>
        </p>
        <p class="small muted">
          Dati sull'ordine: <%= o.customer_name || '—' %> · <%= o.customer_email || '—' %> · <%= o.customer_phone || '—' %>
          · abbinato per <%= o.match_reason || '—' %>
        </p>
        <form class="inline-form small" method="post" action="/orders/<%= encodeURIComponent(o.id) %>/move">
          Sposta su cliente # <input name="customer_id" size="5" required> <button type="submit">Sposta</button>
        </form>
      </div>
    </details>
  <% }) %>
</section>
<%- include('_bottom') %>
